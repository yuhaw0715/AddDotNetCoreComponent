<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="using:DotNetScaffoldStudio.Domain"
        xmlns:vm="using:DotNetScaffoldStudio.Application"
        x:Class="DotNetScaffoldStudio.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource AppTitle}"
        Width="1360"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        Background="#F6F7FB"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="72,*">
    <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
        <Button Width="38" Height="38" Classes="secondary" Content="{DynamicResource MenuGlyph}" Command="{Binding ToggleNavigationCommand}" ToolTip.Tip="{DynamicResource ToggleNavigation}" AutomationProperties.Name="{DynamicResource ToggleNavigation}" TabIndex="0" />
        <StackPanel Grid.Column="1" Margin="14,0,0,0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrandBrush}">
            <TextBlock Text="{DynamicResource BrandMark}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="{DynamicResource AppTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="3" CornerRadius="16" Background="#ECFDF3" Padding="12,6">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="8" Height="8" Fill="#12B76A" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#027A48" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,370,*">
      <Border Grid.Column="0" Width="{Binding NavigationPaneWidth}" HorizontalAlignment="Left" Background="#121826" Padding="16,20">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel IsVisible="{Binding IsNavigationExpanded}" Spacing="8">
            <TextBlock Text="{DynamicResource WorkspaceLabel}" Foreground="#98A2B3" FontSize="11" FontWeight="SemiBold" />
            <Border Background="#1D2939" CornerRadius="8" Padding="11">
              <TextBlock Text="{Binding WorkspacePath}" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="2" FontSize="12" />
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Classes="secondary" Content="{DynamicResource ChooseWorkspace}" Click="ChooseWorkspace_OnClick" AutomationProperties.Name="{DynamicResource ChooseWorkspace}" TabIndex="1" FontSize="12" />
              <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource UseDemoWorkspace}" Command="{Binding UseDemoWorkspaceCommand}" AutomationProperties.Name="{DynamicResource UseDemoWorkspace}" TabIndex="2" FontSize="12" />
            </Grid>
          </StackPanel>

          <Border Grid.Row="1" IsVisible="{Binding IsNavigationExpanded}" Margin="0,18,0,14" Height="1" Background="#344054" />

          <ListBox Grid.Row="2"
                   AutomationProperties.Name="{DynamicResource MainNavigation}"
                   TabIndex="3"
                   IsVisible="{Binding IsNavigationExpanded}"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigation}"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionMode="Single">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="12,11" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="#344054" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="domain:NavigationItem">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="#98A2B3" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox Grid.Row="2"
                   IsVisible="{Binding IsNavigationCollapsed}"
                   AutomationProperties.Name="{DynamicResource MainNavigation}"
                   TabIndex="3"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigation}"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionMode="Single">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="#344054" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="domain:NavigationItem">
                <Border ToolTip.Tip="{Binding Title}" Padding="5">
                  <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="20" HorizontalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="3" IsVisible="{Binding IsNavigationExpanded}" Background="#1D2939" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource DemoSafeModeHeading}" Foreground="#BDB4FE" FontWeight="Bold" FontSize="11" />
              <TextBlock Text="{DynamicResource DemoSafeModeDescription}" Foreground="#D0D5DD" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" IsVisible="{Binding IsFeatureGroup}" Background="#F9FAFB" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="20">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{DynamicResource AvailableFeatures}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding FeatureCountSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{DynamicResource FeatureGroupDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          </StackPanel>

          <TextBox Grid.Row="1" Margin="0,16,0,12" Text="{Binding FeatureSearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FeatureSearchPlaceholder}" AutomationProperties.Name="{DynamicResource FeatureSearchPlaceholder}" TabIndex="4" />

          <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding VisibleFeatures}"
                     AutomationProperties.Name="{DynamicResource FeatureList}"
                     TabIndex="5"
                     SelectedItem="{Binding SelectedFeature}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,0,0,10" />
                  <Setter Property="CornerRadius" Value="10" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="domain:FeatureDefinition">
                  <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#F2F4F7" CornerRadius="12" Padding="8,4" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Badge}" Foreground="#475467" FontSize="10" FontWeight="SemiBold" />
                      </Border>
                      <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{DynamicResource CliLabel}" Foreground="#7F56D9" FontFamily="Menlo" FontSize="10" />
                        <TextBlock Text="{DynamicResource MiddleDot}" Foreground="#7F56D9" FontFamily="Menlo" FontSize="10" />
                        <TextBlock Text="{Binding ShortName}" Foreground="#7F56D9" FontFamily="Menlo" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Row="2" Margin="0,9,0,0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{DynamicResource DependencyLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                          <TextBlock Text="{Binding DependencySummary}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding AvailabilityLabel}" Foreground="#027A48" FontSize="10" />
                          <TextBlock Text="{Binding RiskLabel}" Foreground="#B54708" FontSize="10" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding HasVisibleFeatures, Converter={x:Static BoolConverters.Not}}" Text="{DynamicResource NoMatchingFeatures}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18" />
          </Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" IsVisible="{Binding IsFeatureGroup}">
        <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,Auto" MaxWidth="760" HorizontalAlignment="Stretch">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding SelectedFeatureTitle}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
              <Border Background="#F4EBFF" CornerRadius="13" Padding="9,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedFeatureBadge}" Foreground="#6941C6" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding SelectedFeatureDescription}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1" Margin="0,20,0,0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource ParameterSettings}" FontSize="16" FontWeight="Bold" />
                <CheckBox Grid.Column="1" Content="{DynamicResource ShowAdvancedOptions}" IsChecked="{Binding ParameterEditor.ShowAdvanced}" />
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource TargetProject}" FontSize="12" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" PlaceholderText="{DynamicResource TargetProjectPlaceholder}" AutomationProperties.Name="{DynamicResource TargetProject}" TabIndex="6">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="domain:ProjectInfo">
                        <TextBlock Text="{Binding DisplayText}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding ParameterEditor.VisibleFields}">
                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="vm:TextParameterFieldViewModel">
                    <StackPanel Spacing="5" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Definition.DisplayName}" FontSize="12" FontWeight="SemiBold" />
                      <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" PasswordChar="{Binding PasswordChar}" PlaceholderText="{DynamicResource ParameterValuePlaceholder}" AutomationProperties.Name="{Binding Definition.DisplayName}" />
                      <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="vm:EnumerationParameterFieldViewModel">
                    <StackPanel Spacing="5" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Definition.DisplayName}" FontSize="12" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding AllowedValues}" SelectedItem="{Binding SelectedValue}" AutomationProperties.Name="{Binding Definition.DisplayName}" />
                      <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="vm:BooleanParameterFieldViewModel">
                    <StackPanel Spacing="5" Margin="0,0,0,10">
                      <CheckBox Content="{Binding Definition.DisplayName}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Definition.DisplayName}" />
                      <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Margin="0,16,0,0" Background="#101828" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource CommandPreview}" Foreground="White" FontWeight="SemiBold" />
                <Border Grid.Column="1" Background="#344054" CornerRadius="12" Padding="8,4">
                  <TextBlock Text="{DynamicResource ReadOnly}" Foreground="#D0D5DD" FontSize="10" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding CommandPreviewText}" Foreground="#BDB4FE" FontFamily="Menlo" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource WorkingDirectoryLabel}" Foreground="#98A2B3" FontSize="10" />
                <TextBlock Text="{Binding WorkingDirectoryText}" Foreground="#98A2B3" FontSize="10" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Margin="0,16,0,0" Background="#FFFAEB" BorderBrush="#FEDF89" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{DynamicResource AlertSymbol}" Foreground="#B54708" FontSize="18" FontWeight="Bold" />
              <StackPanel>
                <TextBlock Text="{DynamicResource SafetyCheckHeading}" Foreground="#93370D" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="{Binding AvailabilityMessage}" Foreground="#B54708" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="4" Margin="0,20,0,28" RowDefinitions="Auto,Auto,Auto">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBlock Text="{DynamicResource OperationPreviewHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource ClearResult}" Command="{Binding ClearResultCommand}" AutomationProperties.Name="{DynamicResource ClearResult}" TabIndex="8" />
              <Button Grid.Column="2" Classes="primary" Content="{DynamicResource RunDemo}" Command="{Binding RequestExecutionCommand}" IsEnabled="{Binding CanExecuteSelectedFeature}" AutomationProperties.Name="{DynamicResource RunDemo}" TabIndex="9" />
            </Grid>

            <Border Grid.Row="1" IsVisible="{Binding IsRunning}" Margin="0,16,0,0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding ExecutionStageLabel}" FontWeight="SemiBold" />
                  <Button Grid.Column="1" Content="{DynamicResource Cancel}" Command="{Binding CancelExecutionCommand}" AutomationProperties.Name="{DynamicResource Cancel}" />
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                <ProgressBar IsIndeterminate="True" Height="5" />
                <TextBox Text="{Binding ExecutionOutput}" IsReadOnly="True" AcceptsReturn="True" MinHeight="100" FontFamily="Menlo" FontSize="11" />
              </StackPanel>
            </Border>

            <Border Grid.Row="2" IsVisible="{Binding HasResult}" Margin="0,16,0,0" Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ResultTitle}" Foreground="#027A48" FontSize="16" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{DynamicResource ExecutionStage}" Foreground="#05603A" FontSize="11" />
                  <TextBlock Text="{Binding ExecutionStageLabel}" Foreground="#05603A" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding ResultSummary}" Foreground="#05603A" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="{Binding GitDifferenceSummary}" Foreground="#05603A" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="{DynamicResource ExistingChanges}" FontWeight="SemiBold" Foreground="#05603A" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding ExistingChanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <TextBlock Text="{Binding}" Foreground="#05603A" FontFamily="Menlo" FontSize="11" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource GeneratedChanges}" FontWeight="SemiBold" Foreground="#05603A" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding ResultFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <TextBlock Text="{Binding}" Foreground="#05603A" FontFamily="Menlo" FontSize="11" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary" Content="{DynamicResource OpenInFinder}" Command="{Binding OpenResultInFinderCommand}" IsEnabled="{Binding CanOpenResultInFinder}" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </ScrollViewer>

      <Border Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsContentPage}" Background="#F9FAFB" Padding="42">
        <ScrollViewer>
          <StackPanel MaxWidth="860" Spacing="18" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SelectedNavigation.Title}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
              <TextBlock Text="{Binding SelectedNavigation.Subtitle}" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>

            <Border IsVisible="{Binding IsWorkspacePage}" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
              <StackPanel Spacing="14">
                <TextBlock Text="{DynamicResource WorkspacePageHeading}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource WorkspacePageDescription}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <Border Background="#F9FAFB" CornerRadius="8" Padding="14">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{DynamicResource WorkspaceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding WorkspacePath}" FontFamily="Menlo" />
                  </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource TargetProject}" FontSize="13" FontWeight="SemiBold" />
                  <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding HasProjects}" PlaceholderText="{DynamicResource NoTargetProjectSelected}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="domain:ProjectInfo">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayText}" />
                          <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock IsVisible="{Binding RequiresProjectSelection}" Text="{DynamicResource TargetProjectSelectionHint}" Foreground="#B54708" FontSize="11" TextWrapping="Wrap" />
                  <TextBlock IsVisible="{Binding IsProjectsEmpty}" Text="{DynamicResource NoProjectsInWorkspace}" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsHistoryPage}" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource HistoryPageHeading}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource HistoryPageDescription}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource NoExecutionHistory}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsSettingsPage}" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource SettingsPageHeading}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource SettingsPageDescription}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <CheckBox Content="{DynamicResource EnableSafeModePrompt}" IsChecked="True" AutomationProperties.Name="{DynamicResource EnableSafeModePrompt}" />
                <CheckBox Content="{DynamicResource ShowConfirmationBeforeExecution}" IsChecked="True" AutomationProperties.Name="{DynamicResource ShowConfirmationBeforeExecution}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.RowSpan="2" IsVisible="{Binding IsConfirmationVisible}" Background="#B3121826" ZIndex="100">
      <Border Width="520" Background="White" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <Border Width="44" Height="44" Background="#FFF4E5" CornerRadius="22" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource AlertSymbol}" Foreground="#B54708" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ConfirmationTitle}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding ConfirmationMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Border Background="#101828" CornerRadius="9" Padding="14">
            <TextBlock Text="{Binding CommandPreviewText}" Foreground="#BDB4FE" FontFamily="Menlo" FontSize="11" TextWrapping="Wrap" />
          </Border>
          <Border IsVisible="{Binding IsHighRiskConfirmation}" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding ConfirmationDetails}" Foreground="#B42318" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="{DynamicResource SafeDemoLabel}" Foreground="#7F56D9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource Cancel}" Command="{Binding CancelConfirmationCommand}" AutomationProperties.Name="{DynamicResource Cancel}" />
            <Button Grid.Column="2" Classes="primary" Content="{DynamicResource Confirm}" Command="{Binding ConfirmExecutionCommand}" AutomationProperties.Name="{DynamicResource Confirm}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
