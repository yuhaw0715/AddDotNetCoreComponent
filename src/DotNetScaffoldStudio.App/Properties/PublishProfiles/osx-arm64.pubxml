<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)/../../artifacts/publish/$(RuntimeIdentifier)/</PublishDir>
    <MacOsAppBundlePath>$(MSBuildProjectDirectory)/../../artifacts/DotNet Scaffold Studio-$(RuntimeIdentifier).app</MacOsAppBundlePath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../../packaging/macos/SelfContainedMacOsApp.targets" />
</Project>
