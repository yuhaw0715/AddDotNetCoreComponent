<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="AppTitle">DotNet Scaffold Studio</x:String>
  <x:String x:Key="AppSubtitle">把繁瑣的 .NET CLI 變成清楚、安全的操作流程</x:String>
  <x:String x:Key="WorkspaceLabel">目前工作區</x:String>
  <x:String x:Key="ChooseWorkspace">選擇資料夾</x:String>
  <x:String x:Key="UseDemoWorkspace">使用示範資料</x:String>
  <x:String x:Key="TargetProject">目標專案</x:String>
  <x:String x:Key="AvailableFeatures">可用功能</x:String>
  <x:String x:Key="ParameterSettings">參數設定</x:String>
  <x:String x:Key="CommandPreview">命令預覽</x:String>
  <x:String x:Key="RunDemo">執行示意</x:String>
  <x:String x:Key="Cancel">取消</x:String>
  <x:String x:Key="Confirm">確認並執行示意</x:String>
  <x:String x:Key="ToggleNavigation">切換主要導覽</x:String>
  <x:String x:Key="WorkspacePageHeading">工作區與目標專案</x:String>
  <x:String x:Key="WorkspacePageDescription">檢視目前工作區、掃描到的專案與產生目標。</x:String>
  <x:String x:Key="HistoryPageHeading">執行紀錄</x:String>
  <x:String x:Key="HistoryPageDescription">正式流程會在這裡保存命令、階段狀態與檔案差異摘要。</x:String>
  <x:String x:Key="SettingsPageHeading">設定</x:String>
  <x:String x:Key="SettingsPageDescription">管理工具、介面語言與本機偏好。</x:String>
  <x:String x:Key="NoProjectsInWorkspace">尚未掃描到 .csproj 專案。</x:String>
  <x:String x:Key="NavigationCollapsedHint">導覽已收合；可使用上方按鈕展開。</x:String>
  <x:String x:Key="NoExecutionHistory">目前尚無執行紀錄。</x:String>
  <x:String x:Key="EnableSafeModePrompt">啟用安全模式提示</x:String>
  <x:String x:Key="ShowConfirmationBeforeExecution">命令執行前顯示確認</x:String>
  <x:String x:Key="TargetProjectSelectionHint">工作區包含多個專案，請明確選擇產生目標。</x:String>
  <x:String x:Key="NoTargetProjectSelected">尚未選擇目標專案。</x:String>
  <x:String x:Key="FeatureSearchPlaceholder">搜尋名稱、短名稱或相依性</x:String>
  <x:String x:Key="NoMatchingFeatures">找不到符合搜尋條件的功能。</x:String>
  <x:String x:Key="ShowAdvancedOptions">顯示進階選項</x:String>
  <x:String x:Key="ParameterValuePlaceholder">請輸入參數值</x:String>
  <x:String x:Key="ExecutionStage">目前階段</x:String>
  <x:String x:Key="ExistingChanges">執行前既有變更</x:String>
  <x:String x:Key="GeneratedChanges">執行後檔案差異</x:String>
  <x:String x:Key="OpenInFinder">在 Finder 顯示輸出</x:String>
  <x:String x:Key="MenuGlyph">☰</x:String>
  <x:String x:Key="BrandMark">.N</x:String>
  <x:String x:Key="DemoSafeModeHeading">DEMO SAFE MODE</x:String>
  <x:String x:Key="DemoSafeModeDescription">所有執行皆為模擬，不會修改檔案或資料庫。</x:String>
  <x:String x:Key="FeatureGroupDescription">依用途選擇要產生的項目</x:String>
  <x:String x:Key="TargetProjectPlaceholder">請先選擇工作區</x:String>
  <x:String x:Key="ReadOnly">唯讀</x:String>
  <x:String x:Key="SafetyCheckHeading">平台與安全檢查</x:String>
  <x:String x:Key="OperationPreviewHint">所有操作都會先顯示命令與目標路徑。</x:String>
  <x:String x:Key="ClearResult">清除結果</x:String>
  <x:String x:Key="AlertSymbol">!</x:String>
  <x:String x:Key="SafeDemoLabel">SAFE DEMO</x:String>
  <x:String x:Key="MainNavigation">主要導覽</x:String>
  <x:String x:Key="FeatureList">功能清單</x:String>
  <x:String x:Key="CliLabel">CLI</x:String>
  <x:String x:Key="DependencyLabel">相依性</x:String>
  <x:String x:Key="ChooseWorkspaceDialogTitle">選擇 .NET 工作區</x:String>
  <x:String x:Key="WorkingDirectoryLabel">工作目錄：</x:String>
  <x:String x:Key="MiddleDot">·</x:String>
  <x:String x:Key="Status.WorkspacePlaceholder">尚未選擇工作區</x:String>
  <x:String x:Key="Status.ExecutionOutputEmpty">尚未執行命令。</x:String>
  <x:String x:Key="Status.DemoSafe">Demo 模式 · 不會修改任何檔案</x:String>
  <x:String x:Key="Status.InvalidWorkspace">請先選擇有效的工作區。</x:String>
  <x:String x:Key="Status.Scanning">正在掃描 .NET 專案…</x:String>
  <x:String x:Key="Status.NoProjects">找不到 .csproj；仍可使用專案範本功能。</x:String>
  <x:String x:Key="Status.SingleProject">已找到 1 個專案，已自動選取目標。</x:String>
  <x:String x:Key="Status.MultipleProjects">已找到 {0} 個專案，請選擇目標。</x:String>
  <x:String x:Key="Status.LoadFailure">無法載入工作區：{0}</x:String>
  <x:String x:Key="Status.DemoWorkspaceLoaded">已載入示範工作區 · 2 個專案</x:String>
  <x:String x:Key="Status.HighRiskConfirmation">等待高風險操作二次確認</x:String>
  <x:String x:Key="Status.ConfirmationRequired">請確認命令與目標位置</x:String>
  <x:String x:Key="Status.DemoExecuting">Demo 執行中…</x:String>
  <x:String x:Key="Status.DemoCompleted">示意流程已完成</x:String>
  <x:String x:Key="Status.DemoFailed">示意流程失敗</x:String>
  <x:String x:Key="Status.Cancelled">已取消</x:String>
  <x:String x:Key="Status.FinderFailure">無法顯示輸出位置：{0}</x:String>
  <x:String x:Key="Stage.Idle">閒置</x:String>
  <x:String x:Key="Stage.AwaitingConfirmation">等待確認</x:String>
  <x:String x:Key="Stage.Executing">執行中</x:String>
  <x:String x:Key="Stage.Succeeded">成功</x:String>
  <x:String x:Key="Stage.Failed">失敗</x:String>
  <x:String x:Key="Stage.Cancelled">已取消</x:String>
  <x:String x:Key="Result.CancelledTitle">已取消示意執行</x:String>
  <x:String x:Key="Result.CancelledSummary">正式版本會在取消後重新掃描檔案差異，不會假設工作區未被修改。</x:String>
  <x:String x:Key="Result.CancelledDifference">取消後已重新掃描差異；Demo 未修改工作區。</x:String>
  <x:String x:Key="Result.DemoTitle">示意產生成功</x:String>
  <x:String x:Key="Result.DemoSummary">這是流程 Demo；沒有執行外部 CLI，也沒有修改工作區。正式版本將在此顯示真實結束碼、耗時與差異。</x:String>
  <x:String x:Key="Result.DemoGitStatus">工作樹包含 1 個執行前既有變更；Demo 不會修改工作區。</x:String>
  <x:String x:Key="Result.GitDifferenceFallback">Git 分支：{0}；執行後新增 {1} 項差異，執行前既有 {2} 項變更。</x:String>
  <x:String x:Key="Result.NonGitWorkspace">非 Git 工作區</x:String>
  <x:String x:Key="Feature.Select">選擇一項功能</x:String>
  <x:String x:Key="Feature.DescriptionPlaceholder">從左側選擇功能群組，再挑選要執行的項目。</x:String>
  <x:String x:Key="Feature.CommandPreviewPlaceholder">選擇功能後將顯示命令預覽</x:String>
  <x:String x:Key="Feature.TargetProjectRequired">此功能需要先選擇現有的目標專案。</x:String>
  <x:String x:Key="Feature.AvailableOnPlatform">此功能可在目前平台使用。</x:String>
  <x:String x:Key="Feature.Count">{0} 項功能</x:String>
  <x:String x:Key="Validation.RequiredName">名稱為必填欄位。</x:String>
  <x:String x:Key="Confirmation.DbContextFallback">依專案設定</x:String>
  <x:String x:Key="FileReveal.DemoReady">Demo 已準備在 Finder 顯示：{0}</x:String>
  <x:String x:Key="FileReveal.UnsupportedPlatform">Finder 開啟動作只支援 macOS。</x:String>
  <x:String x:Key="FileReveal.StartFailure">無法啟動 Finder。</x:String>
  <x:String x:Key="FileReveal.Success">已要求 Finder 顯示輸出位置。</x:String>
  <x:String x:Key="FileReveal.Failure">Finder 無法顯示輸出位置。</x:String>
  <x:String x:Key="Execution.StepValidate">[Demo] 正在驗證目標專案…</x:String>
  <x:String x:Key="Execution.StepDependencies">[Demo] 正在檢查所需工具與套件…</x:String>
  <x:String x:Key="Execution.StepPrepare">[Demo] 預備執行：{0}</x:String>
  <x:String x:Key="Execution.StepGenerate">[Demo] 正在模擬產生檔案…</x:String>
  <x:String x:Key="Execution.StepDiff">[Demo] 正在比較 Git 與檔案差異…</x:String>
  <x:String x:Key="Parameter.Name">名稱</x:String>
  <x:String x:Key="Parameter.OutputPath">輸出位置</x:String>
  <x:String x:Key="Parameter.ForceOutput">覆寫既有輸出</x:String>
  <x:String x:Key="Parameter.TemplateMode">範本模式</x:String>
  <x:String x:Key="Parameter.Model">模型</x:String>
  <x:String x:Key="Parameter.DbContext">DbContext</x:String>
  <x:String x:Key="Parameter.NamedConnection">具名連線或來源</x:String>
  <x:String x:Key="Template.Empty">空白</x:String>
  <x:String x:Key="Template.ReadWrite">含讀寫動作</x:String>
  <x:String x:Key="Template.MvcCrud">MVC CRUD</x:String>
  <x:String x:Key="Template.RestApi">REST API</x:String>
  <x:String x:Key="Defaults.ControllerName">OrdersController</x:String>
  <x:String x:Key="Defaults.OutputPath">Controllers</x:String>
  <x:String x:Key="Defaults.GeneratedOutputPath">./generated</x:String>
  <x:String x:Key="Defaults.ProjectName">MyNewApp</x:String>
  <x:String x:Key="Defaults.MigrationName">AddOrderStatus</x:String>
  <x:String x:Key="Defaults.LatestMigration">Latest</x:String>
  <x:String x:Key="Defaults.RazorComponentName">OrderSummary</x:String>
  <x:String x:Key="Defaults.PageName">Orders</x:String>
  <x:String x:Key="Defaults.WorkingDirectory">/path/to/workspace</x:String>
</ResourceDictionary>
